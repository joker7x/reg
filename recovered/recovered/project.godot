[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[file_customization]

folder_colors={
"res://art/": "yellow",
"res://audio/": "pink",
"res://fonts/": "teal",
"res://resources/": "green",
"res://scenes/": "purple",
"res://system/": "red"
}

[gui]

theme/custom_font="uid://bwl8hoao1ybof"

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.ar.translation", "res://translations/strings.en.translation")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
